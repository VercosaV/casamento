APP_NAME=Convite
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=America/Sao_Paulo

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Chave do login: rode `php artisan jwt:secret` e ele cria a linha sozinho.
# Não escreva o nome dessa chave aqui (nem em comentário): o comando acha que ela já existe e não cria.

# Contas dos noivos (opcional: também dá para usar php artisan casamento:criar-noivo)
NOIVO_EMAIL=
NOIVO_PASSWORD=
NOIVA_EMAIL=
NOIVA_PASSWORD=

# Stripe (pagamento dos presentes). Sem STRIPE_SK o site só deixa "reservar" o presente.
# Use chaves de TESTE (sk_test_...) até o site entrar no ar. Nunca coloque chaves no código.
STRIPE_SK=
STRIPE_WEBHOOK_SECRET=
# Minutos que as cotas ficam seguradas enquanto a pessoa paga (mínimo 31)
STRIPE_MINUTOS_RESERVA=35
# Valor mínimo por pagamento, em centavos (500 = R$ 5,00)
STRIPE_VALOR_MINIMO_CENTAVOS=500
